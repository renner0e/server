[Build]
Arch=amd64
ImageTag=localhost/bootc-image-factory:latest
Pull=newer
# Make a symlink I guess
SetWorkingDirectory=/etc/bootc-image-factory/server

[Service]
ExecStartPost=/usr/bin/bootc switch --quiet --transport=containers-storage localhost/bootc-image-factory:latest
ExecStartPost=/usr/bin/bootc update --quiet
ExecStartPost=/usr/bin/podman image prune --force --filter=label=containers.bootc=1 --filter until=168h
Nice=0
